+//! Standby themes (fork feature — see `fork/FORK.md` in the
+//! ar5rm-firmware repo).
+//!
+//! The theme is selected at COMPILE TIME, one cargo feature per
+//! firmware variant (`theme-apx` / `theme-clean` / `theme-dense` /
+//! `theme-minimal`). Each web-flasher firmware variant carries exactly
+//! one standby renderer; switching themes on a radio means flashing a
+//! different variant, which is also what keeps every variant inside
+//! the 60K application limit (the all-themes-in-one build measured
+//! 64,744 B and did not fit).
+//!
+//! RETIRED (2026-11-24 rework): the first fork design kept the theme in
+//! a `THM1` block at app-data sector 0x195000, written by a THEMES
+//! overlay app and read by the core at boot / on entering standby.
+//! That design is gone — nothing reads or writes that sector anymore
+//! and 0x195000 is free app-data space again. The Settings record was
+//! never involved (it is byte-full and stays CPS-compatible).
+
+use embedded_graphics::pixelcolor::Rgb565;
+
+pub const THEME_APX: u8 = 0;
+pub const THEME_CLEAN: u8 = 1;
+pub const THEME_DENSE: u8 = 2;
+pub const THEME_MINIMAL: u8 = 3;
+
+/// Exactly one theme feature per build — enforced here so a variant
+/// can never silently carry (and pay flash for) two renderers.
+const THEME_FEATURE_COUNT: u32 = cfg!(feature = "theme-apx") as u32
+    + cfg!(feature = "theme-clean") as u32
+    + cfg!(feature = "theme-dense") as u32
+    + cfg!(feature = "theme-minimal") as u32;
+const _: () = assert!(
+    THEME_FEATURE_COUNT == 1,
+    "enable exactly one theme-* feature (default: theme-apx)"
+);
+
+/// The theme compiled into this firmware variant.
+#[cfg(feature = "theme-apx")]
+pub const ACTIVE_THEME: u8 = THEME_APX;
+#[cfg(feature = "theme-clean")]
+pub const ACTIVE_THEME: u8 = THEME_CLEAN;
+#[cfg(feature = "theme-dense")]
+pub const ACTIVE_THEME: u8 = THEME_DENSE;
+#[cfg(feature = "theme-minimal")]
+pub const ACTIVE_THEME: u8 = THEME_MINIMAL;
+
+/// Human-readable name of the compiled-in theme (catalog / docs use).
+#[cfg(feature = "theme-apx")]
+pub const ACTIVE_THEME_NAME: &str = "APX Pro";
+#[cfg(feature = "theme-clean")]
+pub const ACTIVE_THEME_NAME: &str = "Clean Modern";
+#[cfg(feature = "theme-dense")]
+pub const ACTIVE_THEME_NAME: &str = "Data Dense";
+#[cfg(feature = "theme-minimal")]
+pub const ACTIVE_THEME_NAME: &str = "Minimal Dark";
+
+const fn rgb(r: u8, g: u8, b: u8) -> Rgb565 {
+    Rgb565::new(r, g, b)
+}
+
+/// Color scheme for one theme. `panel` doubles as the list title-bar
+/// background on shared screens; `accent` is the focus/highlight color
+/// (for APX Pro that is the amber of the mockup, not green).
+#[derive(Clone, Copy, PartialEq)]
+pub struct Palette {
+    pub bg: Rgb565,
+    pub panel: Rgb565,
+    pub fg: Rgb565,
+    pub slave: Rgb565,
+    pub accent: Rgb565,
+    pub dim: Rgb565,
+    pub hair: Rgb565,
+    pub amber: Rgb565,
+    pub green: Rgb565,
+    pub alert: Rgb565,
+}
+
+/// Palette of the compiled-in theme. `ACTIVE_THEME` is a const, so
+/// the non-selected arms below are const-folded away.
+pub fn active_palette() -> Palette {
+    palette(ACTIVE_THEME)
+}
+
+pub fn palette(id: u8) -> Palette {
+    match id {
+        THEME_CLEAN => Palette {
+            bg: rgb(1, 6, 10),
+            panel: rgb(3, 12, 19),
+            fg: rgb(30, 62, 30),
+            slave: rgb(17, 32, 24),
+            accent: rgb(8, 50, 31),
+            dim: rgb(10, 21, 25),
+            hair: rgb(4, 10, 14),
+            amber: rgb(31, 50, 0),
+            green: rgb(10, 57, 17),
+            alert: rgb(31, 8, 4),
+        },
+        THEME_DENSE => Palette {
+            bg: rgb(0, 0, 0),
+            panel: rgb(0, 0, 0),
+            fg: rgb(0, 57, 11),
+            slave: rgb(0, 34, 7),
+            accent: rgb(0, 57, 11),
+            dim: rgb(0, 30, 6),
+            hair: rgb(0, 20, 4),
+            amber: rgb(31, 50, 0),
+            green: rgb(0, 57, 11),
+            alert: rgb(31, 8, 4),
+        },
+        THEME_MINIMAL => Palette {
+            bg: rgb(0, 0, 0),
+            panel: rgb(0, 0, 0),
+            fg: rgb(31, 63, 31),
+            slave: rgb(9, 18, 9),
+            accent: rgb(31, 63, 31),
+            dim: rgb(13, 26, 13),
+            hair: rgb(5, 10, 5),
+            amber: rgb(31, 50, 0),
+            green: rgb(0, 55, 6),
+            alert: rgb(31, 8, 4),
+        },
+        _ => Palette {
+            // APX Pro (default; also the upstream palette with the accent
+            // moved to amber, per the approved mockup).
+            bg: rgb(0, 0, 0),
+            panel: rgb(2, 6, 12),
+            fg: rgb(31, 63, 31),
+            slave: rgb(20, 40, 20),
+            accent: rgb(31, 50, 0),
+            dim: rgb(13, 26, 13),
+            hair: rgb(6, 12, 6),
+            amber: rgb(31, 50, 0),
+            green: rgb(0, 55, 6),
+            alert: rgb(31, 8, 4),
+        },
+    }
+}
