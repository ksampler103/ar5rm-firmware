+#[inline(never)]
+fn clean_card_big<D>(
+    lcd: &mut D,
+    app: &app::App,
+    i: usize,
+    snap: &Snapshot,
+    pal: Palette,
+) where
+    D: DrawTarget<Color = Rgb565>,
+{
+    let x = CLEAN_CARD_X + 6;
+    let label_base = CLEAN_BIG_Y + 13;
+    let freq_base = CLEAN_BIG_Y + 36;
+    let info_base = CLEAN_BIG_Y + CLEAN_BIG_H - 5;
+
+    if app.channel_input_len() > 0 {
+        let mut buf: TextBuf<8> = TextBuf::new();
+        channel_input_text(app, &mut buf);
+        text(lcd, buf.as_str(), &FONT_6X10, x, label_base, pal.amber);
+    } else {
+        let mut label: TextBuf<24> = TextBuf::new();
+        side_label(app, i, &mut label);
+        label.write_str(" · MAIN").ok();
+        text(lcd, label.as_str(), &FONT_6X10, x, label_base, pal.accent);
+    }
+
+    let name = app.side_name_str(i);
+    let has_name = app.side_is_channel_mode(i) && !name.is_empty();
+    if app.freq_input_len() > 0 {
+        let mut buf: TextBuf<8> = TextBuf::new();
+        freq_input_text(app, &mut buf);
+        text(lcd, buf.as_str(), &FONT_9X18, x, freq_base, pal.amber);
+    } else {
+        match app.channel_display_mode() {
+            ChannelDisplayMode::Name if has_name => {
+                let shown = &name[..name.len().min(16)];
+                text(lcd, shown, &FONT_9X18, x, freq_base, pal.fg);
+            }
+            ChannelDisplayMode::NameFreq if has_name => {
+                let mut f: TextBuf<12> = TextBuf::new();
+                fmt_freq5(snap.sides[i].freq_hz, &mut f);
+                text(lcd, f.as_str(), &FONT_6X10, x, freq_base, pal.fg);
             }
+            _ => draw_frequency_at(lcd, snap.sides[i].freq_hz, x, freq_base, pal.fg),
+        }
+    }
+
+    let mut info: TextBuf<40> = TextBuf::new();
+    clean_info_line(app, i, &mut info);
+    text(lcd, info.as_str(), &FONT_5X8, x, info_base, pal.dim);
+}
