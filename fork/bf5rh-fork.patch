+#[cfg(feature = "theme-clean")]
+#[inline(never)]
+fn clean_full<D>(lcd: &mut D, app: &app::App, snap: &Snapshot, pal: Palette)
+where
+    D: DrawTarget<Color = Rgb565>,
+{
+    fill(lcd, 0, 0, SCREEN_W, SCREEN_H, pal.bg);
+    fill(lcd, 2, 2, SCREEN_W - 4, 14, pal.panel);
+
+    let master = snap.master_index;
+    let slave = 1 - master;
+
+    fill(
+        lcd,
+        CLEAN_CARD_X,
+        CLEAN_BIG_Y,
+        SCREEN_W - 4,
+        CLEAN_BIG_H,
+        pal.panel,
+    );
+    icons::draw_outline(
+        lcd,
+        Point::new(CLEAN_CARD_X, CLEAN_BIG_Y),
+        Size::new((SCREEN_W - 4) as u32, CLEAN_BIG_H as u32),
+        pal.accent,
+    );
+    clean_card_big(lcd, app, master, snap, pal);
+
+    fill(
+        lcd,
+        CLEAN_CARD_X,
+        CLEAN_SMALL_Y,
+        SCREEN_W - 4,
+        CLEAN_SMALL_H,
+        pal.panel,
+    );
+    clean_card_small(lcd, app, slave, snap, pal);
+
+    let mut hint: TextBuf<32> = TextBuf::new();
+    hint.write_str(if snap.dual_standby {
+        "Listening on both"
+    } else {
+        "Single watch"
+    })
+    .ok();
+    if snap.key_locked {
+        hint.write_str(" · Locked").ok();
+    }
+    text(lcd, hint.as_str(), &FONT_5X8, 4, 120, pal.dim);
+
+    draw_overlay_for(lcd, app, pal);
+}
