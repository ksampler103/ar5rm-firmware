+#[cfg(feature = "theme-dense")]
+#[inline(never)]
+fn dense_full<D>(lcd: &mut D, app: &app::App, snap: &Snapshot, pal: Palette)
+where
+    D: DrawTarget<Color = Rgb565>,
+{
+    fill(lcd, 0, 0, SCREEN_W, SCREEN_H, pal.bg);
+    fill(lcd, 0, 11, SCREEN_W, 1, pal.dim);
+    icons::draw_outline(
+        lcd,
+        Point::new(0, DENSE_A_TOP),
+        Size::new(SCREEN_W as u32, 47),
+        pal.dim,
+    );
+
+    let master = snap.master_index;
+    for i in 0..2usize {
+        let is_master = i == master;
+        let l1 = if i == 0 { DENSE_A_L1 } else { DENSE_B_L1 };
+        let fg = if is_master { pal.fg } else { pal.slave };
+
+        // L1: head + name
+        if is_master && app.channel_input_len() > 0 {
+            let mut buf: TextBuf<8> = TextBuf::new();
+            channel_input_text(app, &mut buf);
+            text(lcd, buf.as_str(), &FONT_5X8, 3, l1, pal.amber);
+        } else {
+            let mut head: TextBuf<28> = TextBuf::new();
+            dense_side_head(app, i, is_master, &mut head);
+            if i == 1 {
+                head.write_str(" ").ok();
+                head.write_str(match snap.sides[i].modulation {
+                    Modulation::Fm => "FM",
+                    Modulation::Am => "AM",
+                    Modulation::Usb => "USB",
+                    Modulation::Cw => "CW",
+                    Modulation::Cwf => "CWF",
+                })
+                .ok();
+            }
+            text(lcd, head.as_str(), &FONT_5X8, 3, l1, fg);
+        }
+        if i == 0 {
+            let mut sql: TextBuf<8> = TextBuf::new();
+            write!(sql, "SQL{}", app.settings().sql_level).ok();
+            let w = sql.as_str().len() as i32 * TINY_W;
+            text(lcd, sql.as_str(), &FONT_5X8, SCREEN_W - 3 - w, l1, pal.dim);
+        }
+
+        // L2: RX freq (+ offset) / input states
+        let l2 = l1 + DENSE_LP;
+        if is_master && app.freq_input_len() > 0 {
+            let mut line: TextBuf<16> = TextBuf::new();
+            line.write_str("RX ").ok();
+            freq_input_text(app, &mut line);
+            text(lcd, line.as_str(), &FONT_5X8, 3, l2, pal.amber);
+        } else if !is_master && snap.dtmf_dial_active {
+            let mut buf: TextBuf<17> = TextBuf::new();
+            dtmf_dial_text(app, &mut buf);
+            text(lcd, buf.as_str(), &FONT_5X8, 3, l2, pal.amber);
+        } else {
+            let mut line: TextBuf<24> = TextBuf::new();
+            line.write_str("RX ").ok();
+            fmt_freq5(snap.sides[i].freq_hz, &mut line);
+            if i == 0 {
+                fmt_offset_suffix(
+                    snap.sides[i].offset_hz,
+                    snap.sides[i].freq_dir,
+                    &mut line,
+                );
+            }
+            text(lcd, line.as_str(), &FONT_5X8, 3, l2, fg);
+        }
+
+        if i == 0 {
+            // L3: TX freq + tone
+            let mut line: TextBuf<28> = TextBuf::new();
+            line.write_str("TX ").ok();
+            fmt_freq5(app.side_tx_freq_hz(0), &mut line);
+            fmt_tone_suffix(snap.sides[0].subaudio_tx, &mut line);
+            text(lcd, line.as_str(), &FONT_5X8, 3, l1 + 2 * DENSE_LP, fg);
+            // L4: power / bandwidth (RSSI is a dynamic field, see dense_dyn)
+            let mut line: TextBuf<16> = TextBuf::new();
+            line.write_str("PWR ").ok();
+            line.write_str(match snap.sides[0].power {
+                Power::Low => "LO",
+                Power::Mid => "MD",
+                Power::High => "HI",
+            })
+            .ok();
+            line.write_str(if snap.sides[0].wide_band {
+                " WD"
+            } else {
+                " NB"
+            })
+            .ok();
+            text(lcd, line.as_str(), &FONT_5X8, 3, l1 + 3 * DENSE_LP, fg);
+        } else {
+            // L3: state flags
+            let mut line: TextBuf<32> = TextBuf::new();
+            write!(
+                line,
+                "DW: {} VOX: {} PS: {}",
+                if snap.dual_standby { "ON" } else { "OFF" },
+                if snap.vox { "ON" } else { "OFF" },
+                if snap.power_save { "ON" } else { "OFF" },
+            )
+            .ok();
+            text(lcd, line.as_str(), &FONT_5X8, 3, l1 + 2 * DENSE_LP, pal.dim);
+            // L4: position
+            let mut line: TextBuf<24> = TextBuf::new();
+            if snap.sides[1].is_channel_mode {
+                write!(line, "CH {:03}", snap.sides[1].channel_num).ok();
+            } else {
+                line.write_str("VFO").ok();
+            }
+            if snap.key_locked {
+                line.write_str(" LOCK").ok();
+            }
+            text(lcd, line.as_str(), &FONT_5X8, 3, l1 + 3 * DENSE_LP, pal.dim);
+        }
+    }
+
+    fill(lcd, 0, 105, SCREEN_W, 1, pal.hair);
+    let mut last: TextBuf<32> = TextBuf::new();
+    match app.last_signal_peak() {
+        Some((side, dbm)) => {
+            last.write_str("LAST: ").ok();
+            fmt_freq4(snap.sides[side].freq_hz, &mut last);
+            write!(last, " {}dBm {}", dbm, if side == 0 { "A" } else { "B" }).ok();
+        }
+        None => {
+            last.write_str("LAST: --").ok();
+        }
+    }
+    text(lcd, last.as_str(), &FONT_5X8, 3, 115, pal.dim);
+
+    draw_overlay_for(lcd, app, pal);
+}
+
+#[cfg(feature = "theme-dense")]
+#[inline(never)]
+fn dense_dyn<D>(
+    lcd: &mut D,
+    app: &app::App,
+    pal: Palette,
+    cache: &mut Cache,
+    force: bool,
+) where
+    D: DrawTarget<Color = Rgb565>,
+{
+    let st = status_state(app);
+    let status_changed = force || cache.status != Some(st);
+    if status_changed {
+        cache.status = Some(st);
+    }
+    let bstate = (app.battery_bars(), app.battery_voltage_cv());
+    let batt_changed = force || cache.battery != Some(bstate);
+    if batt_changed {
+        cache.battery = Some(bstate);
+    }
+
+    if status_changed || batt_changed {
+        // header: "AR-5RM 03:52 BATT 7.9V"
+        fill(lcd, 0, 0, SCREEN_W, 11, pal.bg);
+        let mut x = 2;
+        text(lcd, "AR-5RM", &FONT_5X8, x, 9, pal.fg);
+        x += 6 * TINY_W + 2;
+        let mut clock: TextBuf<8> = TextBuf::new();
+        match st.clock_min {
+            Some(min) => fmt_clock24(min, &mut clock),
+            None => {
+                clock.write_str("--:--").ok();
+            }
+        }
+        text(lcd, clock.as_str(), &FONT_5X8, x, 9, pal.dim);
+        x += 5 * TINY_W + 2;
+        text(lcd, "BATT", &FONT_5X8, x, 9, pal.dim);
+        x += 4 * TINY_W + 2;
+        let (_, cv) = bstate;
+        let mut volts: TextBuf<8> = TextBuf::new();
+        fmt_volts(cv, &mut volts);
+        text(lcd, volts.as_str(), &FONT_5X8, x, 9, pal.fg);
+        if st.key_locked {
+            text_right(lcd, "LOCK", &FONT_5X8, 9, pal.amber);
+        }
+    }
+
+    // RSSI fields on A L4 / B L2
+    let ms = meter_state(app);
+    if force || cache.meter != Some(ms) {
+        cache.meter = Some(ms);
+        for i in 0..2usize {
+            let (rx, baseline) = if i == 0 {
+                (DENSE_RSSI0_X, DENSE_A_L1 + 3 * DENSE_LP)
+            } else {
+                (DENSE_RSSI1_X, DENSE_B_L1 + DENSE_LP)
+            };
+            fill(lcd, rx, baseline - 8, SCREEN_W - rx - 2, 10, pal.bg);
+            let mut line: TextBuf<16> = TextBuf::new();
+            line.write_str("RSSI ").ok();
+            let (_, dbm) = signal_reading(app, i);
+            match dbm {
+                Some(dbm) => {
+                    write!(line, "{}", dbm).ok();
+                }
+                None => {
+                    line.write_str("---").ok();
+                }
+            }
+            text(lcd, line.as_str(), &FONT_5X8, rx, baseline, pal.fg);
+        }
+    }
+
+    if status_changed {
+        // bottom status line
+        fill(lcd, 0, 116, SCREEN_W, 12, pal.bg);
+        if st.transmitting {
+            let secs = st.tx_secs.unwrap_or(0);
+            let mut buf: TextBuf<16> = TextBuf::new();
+            buf.write_str("TX ").ok();
+            fmt_timer(secs, &mut buf);
+            text(lcd, buf.as_str(), &FONT_5X8, 3, 125, pal.alert);
+        } else {
+            let mut line: TextBuf<32> = TextBuf::new();
+            write!(
+                line,
+                "WATCH {} · DW {} · PS {}",
+                if app.watching_index() == 0 { "A" } else { "B" },
+                if st.dual_standby { "ON" } else { "OFF" },
+                if st.power_save { "ON" } else { "OFF" },
+            )
+            .ok();
+            text(lcd, line.as_str(), &FONT_5X8, 3, 125, pal.dim);
+        }
+    }
+}
+
+// ---- theme 3: Minimal Dark ----
+//
+// Per the approved mockup (concept4-minimal-dark.png): black screen,
+// battery icon top-left, dim clock top-right, one huge frequency in
+// the middle with the channel name under it, a hairline, and the
+// other band as a single dim line at the bottom. No meter, no flags
+// row. The frequency itself carries the RX/TX state by colour
+// (white idle, green RX, amber last-signal, red TX).
+
+#[cfg(feature = "theme-minimal")]
+const MIN_FREQ_BASELINE: i32 = 76;
+#[cfg(feature = "theme-minimal")]
+const MIN_NAME_BASELINE: i32 = 94;
+#[cfg(feature = "theme-minimal")]
+const MIN_RULE_Y: i32 = 104;
+#[cfg(feature = "theme-minimal")]
+const MIN_SLAVE_BASELINE: i32 = 122;
+
+#[cfg(feature = "theme-minimal")]
+fn minimal_freq_color(kind: RxStatusText, pal: Palette) -> Rgb565 {
+    match kind {
+        RxStatusText::Tx => pal.alert,
+        RxStatusText::Rx => pal.green,
+        RxStatusText::LastSignal => pal.amber,
+        RxStatusText::None => pal.fg,
+    }
+}
+
+#[cfg(feature = "theme-minimal")]
+#[inline(never)]
+fn minimal_full<D>(lcd: &mut D, app: &app::App, snap: &Snapshot, pal: Palette)
+where
+    D: DrawTarget<Color = Rgb565>,
+{
+    fill(lcd, 0, 0, SCREEN_W, SCREEN_H, pal.bg);
+    let master = snap.master_index;
+    let slave = 1 - master;
+
+    // Centre: the input in progress, or the huge frequency.
+    if snap.freq_input_len > 0 {
+        let mut buf: TextBuf<8> = TextBuf::new();
+        freq_input_text(app, &mut buf);
+        text_centered(lcd, buf.as_str(), &FONT_9X18, MIN_FREQ_BASELINE, pal.amber);
+    } else if snap.channel_input_len > 0 {
+        let mut buf: TextBuf<8> = TextBuf::new();
+        channel_input_text(app, &mut buf);
+        text_centered(lcd, buf.as_str(), &FONT_9X18, MIN_FREQ_BASELINE, pal.amber);
+    } else if snap.dtmf_dial_active {
+        let mut buf: TextBuf<17> = TextBuf::new();
+        dtmf_dial_text(app, &mut buf);
+        text_centered(lcd, buf.as_str(), &FONT_6X10, MIN_FREQ_BASELINE, pal.amber);
+    } else {
+        let kind = rx_status_kind(app, master);
+        draw_frequency_centered(
+            lcd,
+            snap.sides[master].freq_hz,
+            MIN_FREQ_BASELINE,
+            minimal_freq_color(kind, pal),
+        );
+    }
+
+    // Channel name under the frequency.
+    let mut name: TextBuf<16> = TextBuf::new();
+    side_label(app, master, &mut name);
+    text_centered(lcd, name.as_str(), &FONT_6X10, MIN_NAME_BASELINE, pal.slave);
+
+    // Hairline, then the other band as one dim line: "162.4750 - NOAA".
+    fill(lcd, (SCREEN_W - 84) / 2, MIN_RULE_Y, 84, 1, pal.hair);
+    let mut line: TextBuf<28> = TextBuf::new();
+    fmt_freq4(snap.sides[slave].freq_hz, &mut line);
+    line.write_str(" - ").ok();
+    side_label(app, slave, &mut line);
+    text_centered(lcd, line.as_str(), &FONT_6X10, MIN_SLAVE_BASELINE, pal.dim);
+
+    draw_overlay_for(lcd, app, pal);
+}
+
+#[cfg(feature = "theme-minimal")]
+#[inline(never)]
+fn minimal_dyn<D>(
+    lcd: &mut D,
+    app: &app::App,
+    pal: Palette,
+    cache: &mut Cache,
+    force: bool,
+) where
+    D: DrawTarget<Color = Rgb565>,
+{
+    // Battery icon, top-left (no volts text — the mockup is icon-only).
+    let batt = (app.battery_bars(), app.battery_voltage_cv());
+    if force || cache.battery != Some(batt) {
+        cache.battery = Some(batt);
+        let charge = match batt.0 {
+            0 | 1 => pal.alert,
+            2 => pal.amber,
+            _ => pal.green,
+        };
+        fill(lcd, 0, 0, icons::BATTERY_W + 8, STATUS_HEIGHT, pal.bg);
+        icons::draw_battery(lcd, 4, 1, batt.0, pal.fg, charge);
+    }
+
+    // Clock / TX timer cluster, top-right.
+    let st = status_state(app);
+    if force || cache.status != Some(st) {
+        cache.status = Some(st);
+        fill(lcd, 88, 0, SCREEN_W - 88, STATUS_HEIGHT, pal.bg);
+        let baseline = FONT_6X10.baseline as i32 + 2;
+        if st.transmitting {
+            let mut buf: TextBuf<8> = TextBuf::new();
+            fmt_timer(st.tx_secs.unwrap_or(0), &mut buf);
+            text_right(lcd, buf.as_str(), &FONT_6X10, baseline, pal.alert);
+        } else if let Some(min) = st.clock_min {
+            let mut clock: TextBuf<8> = TextBuf::new();
+            fmt_clock24(min, &mut clock);
+            text_right(lcd, clock.as_str(), &FONT_6X10, baseline, pal.dim);
+            if st.key_locked {
+                let clock_w = 5 * SMALL_W;
+                icons::draw_padlock(
+                    lcd,
+                    SCREEN_W - RIGHT_MARGIN - clock_w - 12,
+                    2,
+                    pal.amber,
+                );
+            }
+        } else if st.key_locked {
+            icons::draw_padlock(lcd, SCREEN_W - RIGHT_MARGIN - 8, 2, pal.amber);
+        }
+    }
+
+    // Frequency colour follows the master band's RX state. While an
+    // input is being typed the centre shows the input instead, and
+    // structural redraws own it — don't paint over it.
+    let master = app.master_index();
+    let kind = rx_status_kind(app, master);
+    let state = RxStatusState { text: kind };
+    if force || cache.rx_status[master] != Some(state) {
+        cache.rx_status[master] = Some(state);
+        if app.freq_input_len() == 0
+            && app.channel_input_len() == 0
+            && !app.dtmf_dial_active()
+        {
+            fill(lcd, 0, MIN_FREQ_BASELINE - 22, SCREEN_W, 26, pal.bg);
+            // Mirror Snapshot::capture: while transmitting, the centre
+            // shows the TX frequency, not the RX one.
+            let freq = if app.is_transmitting() {
+                app.side_tx_freq_hz(master)
+            } else {
+                app.side_freq_hz(master)
+            };
+            draw_frequency_centered(lcd, freq, MIN_FREQ_BASELINE, minimal_freq_color(kind, pal));
         }
     }
 }
