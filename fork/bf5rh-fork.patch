+#[inline(never)]
+fn status_state(app: &app::App) -> StatusState {
+    let utc = app.utc_secs();
+    let clock_min = if utc == bf5rh_abi::UTC_NOT_SET {
+        None
+    } else {
+        Some((utc / 60) % 1440)
+    };
+    StatusState {
+        transmitting: app.is_transmitting(),
+        power_save: app.power_save_active(),
+        dual_standby: app.dual_standby_enabled(),
+        vox: app.vox_enabled(),
+        key_locked: app.is_key_locked(),
+        clock_min,
+        tx_secs: app.is_transmitting().then(|| app.tx_elapsed_seconds()),
+    }
+}
+
+/// Signal reading for one side: (kind, dbm when known). Shared by all
+/// themes' dynamic signal fields so the logic exists exactly once.
+#[inline(never)]
+fn signal_reading(app: &app::App, i: usize) -> (RxStatusText, Option<i32>) {
+    match rx_status_kind(app, i) {
+        RxStatusText::Rx => (RxStatusText::Rx, Some(app.rssi_dbm())),
+        RxStatusText::LastSignal => (
+            RxStatusText::LastSignal,
+            app.last_signal_peak().map(|(_, dbm)| dbm),
+        ),
+        RxStatusText::Tx => (RxStatusText::Tx, None),
+        RxStatusText::None => (RxStatusText::None, None),
+    }
+}
+
+#[inline(never)]
+fn rx_status_kind(app: &app::App, i: usize) -> RxStatusText {
+    let is_master = i == app.master_index();
+    let is_watching = i == app.watching_index();
+    let transmitting_here = app.is_transmitting() && is_master;
+    if transmitting_here {
+        RxStatusText::Tx
+    } else if is_watching && (app.is_monitor() || app.rssi_open()) {
+        if app.rx_blink_on() {
+            RxStatusText::Rx
+        } else {
+            RxStatusText::None
+        }
+    } else if app.last_signal_side() == Some(i) {
+        RxStatusText::LastSignal
+    } else {
+        RxStatusText::None
+    }
+}
