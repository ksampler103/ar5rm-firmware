+#[cfg(feature = "theme-clean")]
+#[inline(never)]
+fn clean_dyn<D>(
+    lcd: &mut D,
+    app: &app::App,
+    pal: Palette,
+    cache: &mut Cache,
+    force: bool,
+) where
+    D: DrawTarget<Color = Rgb565>,
+{
+    // status pill, left region
+    let st = status_state(app);
+    if force || cache.status != Some(st) {
+        cache.status = Some(st);
+        fill(lcd, 5, 3, 94, 12, pal.panel);
+        if st.transmitting {
+            let secs = st.tx_secs.unwrap_or(0);
+            let mut buf: TextBuf<8> = TextBuf::new();
+            fmt_timer(secs, &mut buf);
+            text(lcd, buf.as_str(), &FONT_6X10, 8, 13, pal.alert);
+        } else {
+            let mut x = 8;
+            if let Some(min) = st.clock_min {
+                let h24 = min / 60;
+                let h12 = (h24 + 11) % 12 + 1;
+                let mut clock: TextBuf<12> = TextBuf::new();
+                write!(
+                    clock,
+                    "{}:{:02} {}",
+                    h12,
+                    min % 60,
+                    if h24 < 12 { "AM" } else { "PM" }
+                )
+                .ok();
+                text(lcd, clock.as_str(), &FONT_5X8, x, 12, pal.dim);
+                x += clock.as_str().len() as i32 * TINY_W + 4;
+            }
+            for (on, label, color) in [
+                (st.dual_standby, "DW", pal.accent),
+                (st.vox, "VX", pal.amber),
+                (st.power_save, "PS", pal.dim),
+            ] {
+                if on && x + 2 * TINY_W <= 97 {
+                    text(lcd, label, &FONT_5X8, x, 12, color);
+                    x += 3 * TINY_W;
+                }
+            }
+            if st.key_locked && x + 8 <= 97 {
+                icons::draw_padlock(lcd, x, 4, pal.amber);
+            }
+        }
+    }
+
+    // battery, pill right region
+    let bstate = (app.battery_bars(), app.battery_voltage_cv());
+    if force || cache.battery != Some(bstate) {
+        cache.battery = Some(bstate);
+        fill(lcd, 100, 3, 55, 12, pal.panel);
+        let (bars, cv) = bstate;
+        let icon_x = SCREEN_W - 6 - icons::BATTERY_W;
+        let mut volts: TextBuf<8> = TextBuf::new();
+        write!(volts, "{}.{:02}V", cv / 100, cv % 100).ok();
+        let vw = volts.as_str().len() as i32 * TINY_W;
+        text(lcd, volts.as_str(), &FONT_5X8, icon_x - 4 - vw, 12, pal.dim);
+        let charge = match bars {
+            0 | 1 => pal.alert,
+            2 => pal.amber,
+            _ => pal.green,
+        };
+        icons::draw_battery(lcd, icon_x, 4, bars, pal.dim, charge);
+    }
+
+    // per-card signal text + MIC bar
+    let ms = meter_state(app);
+    let meter_changed = force || cache.meter != Some(ms);
+    for s in 0..2usize {
+        let kind = rx_status_kind(app, s);
+        let rxs = RxStatusState { text: kind };
+        if meter_changed || cache.rx_status[s] != Some(rxs) {
+            cache.rx_status[s] = Some(rxs);
+            let (ry, rh) = if s == app.master_index() {
+                (CLEAN_BIG_Y + 5, 11)
+            } else {
+                (CLEAN_SMALL_Y + 5, 11)
+            };
+            fill(lcd, 102, ry, 52, rh, pal.panel);
+            let base = ry + 9;
+            let mut line: TextBuf<12> = TextBuf::new();
+            let mut color = pal.dim;
+            if ms.tx && s == app.master_index() {
+                line.write_str("TX").ok();
+                color = pal.alert;
+            } else {
+                let (kind2, dbm) = signal_reading(app, s);
+                match kind2 {
+                    RxStatusText::Rx => {
+                        if let Some(dbm) = dbm {
+                            write!(line, "{} dBm", dbm).ok();
+                        }
+                        color = pal.green;
+                    }
+                    RxStatusText::LastSignal => {
+                        if let Some(dbm) = dbm {
+                            write!(line, "{} dBm", dbm).ok();
+                        }
+                    }
+                    RxStatusText::Tx => {
+                        line.write_str("TX").ok();
+                        color = pal.alert;
+                    }
+                    RxStatusText::None => {}
+                }
+            }
+            if !line.as_str().is_empty() {
+                let w = line.as_str().len() as i32 * TINY_W;
+                text(lcd, line.as_str(), &FONT_5X8, 152 - w, base, color);
+            }
+        }
+    }
+    if meter_changed {
+        cache.meter = Some(ms);
+        // MIC bar shares the hint row's right end while transmitting.
+        fill(lcd, 96, 110, 62, 14, pal.bg);
+        if ms.tx {
+            text(lcd, "MIC", &FONT_5X8, 98, 120, pal.alert);
+            let level = (ms.level as u16 * 10 / MIC_BAR_SEGS as u16) as u8;
+            draw_bar(lcd, 116, 122, level, 8, Some(pal.alert), pal);
+        }
+    }
+}
+
+// ---- theme 2: Data Dense ----
+
+const DENSE_A_TOP: i32 = 13;
+const DENSE_A_L1: i32 = 22;
+const DENSE_LP: i32 = 10; // line pitch
+const DENSE_B_L1: i32 = 71;
+const DENSE_RSSI0_X: i32 = 53;
+const DENSE_RSSI1_X: i32 = 63;
+
+#[inline(never)]
+fn dense_side_head(
+    app: &app::App,
+    i: usize,
+    master: bool,
+    out: &mut TextBuf<28>,
+) {
+    out.write_str(if i == 0 { "A" } else { "B" }).ok();
+    out.write_str(if master { ">" } else { " " }).ok();
+    side_label(app, i, out);
+}
