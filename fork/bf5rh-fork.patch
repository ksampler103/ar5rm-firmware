+// ---- theme 1: Clean Modern ----
+
+const CLEAN_CARD_X: i32 = 2;
+const CLEAN_BIG_Y: i32 = 19;
+const CLEAN_BIG_H: i32 = 55;
+const CLEAN_SMALL_Y: i32 = 77;
+const CLEAN_SMALL_H: i32 = 31;
+
+#[inline(never)]
+fn clean_info_line(app: &app::App, i: usize, out: &mut TextBuf<40>) {
+    let offset = app.side_offset_hz(i);
+    if offset == 0 {
+        out.write_str("Simplex").ok();
+    } else {
+        let sign = match app.side_freq_dir(i) {
+            1 => "+",
+            2 => "-",
+            _ => "",
+        };
+        write!(out, "Rpt {}{}", sign, offset / 1_000_000).ok();
+        let tenth = (offset % 1_000_000) / 100_000;
+        if tenth > 0 {
+            write!(out, ".{}", tenth).ok();
+        }
+    }
+    out.write_str(" · ").ok();
+    match app.side_subaudio_tx(i) {
+        SubAudio::Ctcss(t) => {
+            write!(out, "T{}.{}", t / 10, t % 10).ok();
+        }
+        SubAudio::Dcs { code, inverted } => {
+            write!(out, "D{:03o}{}", code, if inverted { "I" } else { "" }).ok();
+        }
+        SubAudio::None => {
+            out.write_str("No tone").ok();
+        }
+    }
+    out.write_str(" · ").ok();
+    out.write_str(match app.side_power(i) {
+        Power::Low => "Low",
+        Power::Mid => "Mid",
+        Power::High => "High",
+    })
+    .ok();
+}
